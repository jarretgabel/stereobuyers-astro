---
import PageRoute from '../../components/PageRoute.astro';
import { allPages } from '../../lib/site';

export function getStaticPaths() {
  return allPages
    .filter((p) => p.url.endsWith('/'))
    .map((page) => ({ params: { dir: page.url === '/' ? undefined : page.url.slice(1, -1) }, props: { page } }));
}
const { page } = Astro.props;
---
<PageRoute page={page} />
