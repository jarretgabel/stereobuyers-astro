---
import BrandGrid from './BrandGrid.astro';
import QuickFacts from './QuickFacts.astro';
import { pages } from '../lib/site';
import type { Page } from '../lib/site';
import { brandLayoutSlug } from '../lib/product';
import { isBlank } from '../lib/liquid';

interface Props { page: Page; alwaysQuickFacts?: boolean }
const { page, alwaysQuickFacts = false } = Astro.props;
const history = pages.filter((p) => p.brand === page.brand && p.type === 'history');
const brandSlug = brandLayoutSlug(page.brand);
const items = pages.filter((p) => p.layout === brandSlug);
---
{!isBlank(page.brand_intro) && (
  <section class="container xxnarrow margin-center autospacing-next">
    <p set:html={page.brand_intro} />
  </section>
)}

{!isBlank(page.adamSays) && (
  <section class="adam-says container xxnarrow margin-center autospacing-next">
    <h2 class="text-align-center">
      <span>
        <img class="image" alt="Adam Wexler" src="/assets/media/adam.png" />
      </span>
      <span>Adam Says</span>
    </h2>
    <p set:html={page.adamSays} />
  </section>
)}

{history.length > 0 && (
  <section class="container xxnarrow margin-center autospacing-next">
    <h2 class="text-align-center as-h4">Brief History of {page.brand}</h2>
    {history.map((h) => <p set:html={h.history} />)}
  </section>
)}

<section class="container xxnarrow margin-center autospacing-next">
  <h2 class="text-align-center as-h4">Other {page.brand} Products We Often Buy</h2>
  {!isBlank(page.brand_buy)
    ? <p set:html={page.brand_buy} />
    : <p>Typically, StereoBuyers purchases mostly used amplifiers, especially the vintage amps and high-end {page.brand} models.</p>}
  <p>StereoBuyers has purchased <em>tens of thousands</em> worth {page.brand} brand equipment since 2014, with individual buys ranging from $100 to well over $50,000. If you are moving, ready to upgrade, or have {page.brand} equipment you do not or will not be using, why not contact us today to find out if it is worth good money?</p>
  <p>If you are interested in selling your used {page.brand} equipment to us in the greater NYC area or Colorado, please <a href="/get-a-quote/">click here to fill out a Free Quote Form</a> and we will get back to you. If we agree on terms, we come to meet you where you want, and pay cash.</p>
  <p>Not sure we pick up near you? See our <a href="/service-area/">service area</a> or learn <a href="/how-to-sell-your-high-end-audio-equipment-and-components-with-StereoBuyers/">how selling to StereoBuyers works</a>.</p>
  <p>The following images show actual {page.brand} equipment purchased by StereoBuyers.</p>
</section>

<BrandGrid items={items} />

{(alwaysQuickFacts || page.snippet !== 'product') && <QuickFacts />}
