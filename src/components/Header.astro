---
import { site, settings } from '../lib/site';
const norm = (u: string) => u.replace(/\/+$/, '') || '/';
const here = norm(Astro.url.pathname);
---
<header class="header active">
  <div class="background"></div>
  <div class="identity container flex flex-vcenter flex-hcenter">
    <a class="logo text-grey title-font" href="/"><span class="text-grey">Stereo</span><span class="text-turq">Buyers</span></a>
  </div>
  <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation">
    <span class="hamburger" aria-hidden="true">
      <span class="line"></span>
      <span class="line"></span>
      <span class="line"></span>
      <span class="line"></span>
      <span class="line"></span>
      <span class="line"></span>
    </span>
  </button>
  <nav id="primary-navigation" class="nav-list padding-bottom-2" aria-label="Primary">
    <div class="list text-align-right-desktop text-align-center-mobile">
      <div class="scroll">
        {settings.nav.map((item) => (
          <div class="list-item title-font">
            <a class="nav-item" href={item.url} aria-current={norm(item.url) === here ? 'page' : undefined}>{item.label}</a>
          </div>
        ))}
        <div class="list-item tall title-font text-grey">
          <a class="nav-item text-grey" href="/get-a-quote/" aria-current={here === '/get-a-quote' ? 'page' : undefined}>{settings.navCta}</a>
        </div>
      </div>
    </div>
  </nav>
</header>

<div class="sticky-contact transY100">
  <div class="container text-align-center">
    <p class="text-white display-none-mobile">{settings.stickyIntro} <a class="link item tertiary-font text-white text-uppercase" href="/get-a-quote/">{settings.stickyButton}</a> or call us at <span class="item text-white phone phone-number-for-google-disable tertiary-font">{site.phone}</span> or <a class="item tertiary-font text-white" href={`mailto:${settings.email}`}>{settings.email}</a></p>
    <p class="text-white display-none-tablet-desktop"><a class="link item tertiary-font text-white text-uppercase" href="/get-a-quote/">{settings.stickyButton}</a> or <span class="item text-white phone phone-number-for-google tertiary-font">{site.phone}</span><br /><a class="item tertiary-font text-white" href={`mailto:${settings.email}`}>{settings.email}</a></p>
  </div>
</div>
