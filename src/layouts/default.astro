---
import { ClientRouter } from 'astro:transitions';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Content from '../components/Content.astro';
import type { Page } from '../lib/site';

interface Props {
  page: Page;
  layoutDescription?: string;
}
const { page, layoutDescription } = Astro.props;
const identityScript = `// Netlify Identity is only needed for CMS invite/recovery links that land on any page
if (/(invite|recovery|confirmation|email_change)_token=/.test(window.location.hash)) {
  var identity = document.createElement("script");
  identity.src = "https://identity.netlify.com/v1/netlify-identity-widget.js";
  identity.onload = function() {
    window.netlifyIdentity.on("init", function(user) {
      if (!user) {
        window.netlifyIdentity.on("login", function() {
          document.location.href = "/admin/";
        });
      }
    });
    window.netlifyIdentity.init();
  };
  document.head.appendChild(identity);
}`;
---
<!doctype html>
<html lang="en">
  <Head page={page} layoutDescription={layoutDescription} />
  <ClientRouter />
  <body class={`${page.slug ?? ''}-body`}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot><Content page={page} /></slot>
    </main>
    <Footer />
    <script is:inline set:html={identityScript} />
  </body>
  <style is:global>
    /* Page-to-page fade: old page fades out, then the new page fades in. Reduced motion gets a near-zero duration so swaps still complete. */
    @keyframes sb-fade-out { from { opacity: 1; } to { opacity: 0; } }
    @keyframes sb-fade-in { from { opacity: 0; } to { opacity: 1; } }
    ::view-transition-old(root),
    ::view-transition-new(root) {
      mix-blend-mode: normal;
    }
    ::view-transition-old(root) {
      animation: 0.15s ease-in both sb-fade-out;
    }
    ::view-transition-new(root) {
      animation: 0.15s ease-out 0.15s both sb-fade-in;
    }
    [data-astro-transition-fallback="old"] body {
      animation: 0.15s ease-in both sb-fade-out;
    }
    [data-astro-transition-fallback="new"] body {
      animation: 0.15s ease-out both sb-fade-in;
    }
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-old(root),
      ::view-transition-new(root),
      [data-astro-transition-fallback] {
        animation-duration: 0.01ms !important;
      }
    }
  </style>
</html>
