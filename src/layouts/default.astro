---
import { ClientRouter } from 'astro:transitions';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Content from '../components/Content.astro';
import type { Page } from '../lib/site';

interface Props {
  page: Page;
  layoutDescription?: string;
}
const { page, layoutDescription } = Astro.props;
const identityScript = `// Netlify Identity is only needed for CMS invite/recovery links that land on any page
if (/(invite|recovery|confirmation|email_change)_token=/.test(window.location.hash)) {
  var identity = document.createElement("script");
  identity.src = "https://identity.netlify.com/v1/netlify-identity-widget.js";
  identity.onload = function() {
    window.netlifyIdentity.on("init", function(user) {
      if (!user) {
        window.netlifyIdentity.on("login", function() {
          document.location.href = "/admin/";
        });
      }
    });
    window.netlifyIdentity.init();
  };
  document.head.appendChild(identity);
}`;
---
<!doctype html>
<html lang="en">
  <Head page={page} layoutDescription={layoutDescription} />
  <ClientRouter />
  <body class={`${page.slug ?? ''}-body`}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot><Content page={page} /></slot>
    </main>
    <Footer />
    <script is:inline set:html={identityScript} />
  </body>
  <style is:global>
    /* Only the page content transitions: it eases out, then rises gently into place. Header, call-to-action bar and footer are identical on every page, so they stay put. */
    @keyframes sb-out { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(-10px); } }
    @keyframes sb-in { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes sb-show { from { opacity: 0; } to { opacity: 1; } }
    main#main { view-transition-name: page; }
    header.header { view-transition-name: site-header; }
    .sticky-contact { view-transition-name: site-cta; }
    ::view-transition-group(site-header),
    ::view-transition-group(site-cta) { z-index: 2; }
    ::view-transition-group(*) { animation-duration: 0s; }
    ::view-transition-old(*),
    ::view-transition-new(*) { mix-blend-mode: normal; animation: none; }
    ::view-transition-old(page) { animation: 0.25s cubic-bezier(0.4, 0, 1, 1) both sb-out; }
    ::view-transition-new(page) { animation: 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both sb-in; }
    /* The new page frame (footer, spacing) appears as the old content finishes leaving. */
    ::view-transition-new(root) { animation: 0.01s linear 0.25s both sb-show; }
    [data-astro-transition-fallback="old"] main#main { animation: 0.25s cubic-bezier(0.4, 0, 1, 1) both sb-out; }
    [data-astro-transition-fallback="new"] main#main { animation: 0.8s cubic-bezier(0.16, 1, 0.3, 1) both sb-in; }
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-old(*),
      ::view-transition-new(*),
      main#main {
        animation-duration: 0.01ms !important;
        animation-delay: 0s !important;
      }
    }
  </style>
</html>
