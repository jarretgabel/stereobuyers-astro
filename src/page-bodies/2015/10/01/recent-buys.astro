---
import ResponsiveImg from '../../../../components/ResponsiveImg.astro';
---

<div class="container text-align-center">
  <div class='intro half-autospacing'>
    <h2>Recent Stereo Buys</h2>
    <p class="xxxnarrow margin-auto">Please see the images below for some examples of the types of high-end speakers, amplifiers and components we have recently purchased:</p>
  </div>
  <ul class='columns double-autospacing flex-row-col flex-wrap justify-space-between margin-top-0'>
    <li class='column quarter-autospacing margin-top-4 rel'>
      <div class="rel ov-h">
        <ResponsiveImg class="image" src="/assets/media/marantz-model-1-audio-consolette-preamplifier.jpg" alt="Marantz Model 1 Audio Consolette Preamplifier" sizes="(min-width: 800px) 33vw, 100vw" />
      </div>
      <div class="caption">
        <p class="padding-top-0 padding-bottom-0">Marantz Model 1 Audio Consolette Preamplifier</p>
      </div>
    </li>
    <li class='column quarter-autospacing rel'>
      <div class="rel ov-h">
        <ResponsiveImg class="image" src="/assets/media/clearaudio-champion-turntable.jpg" alt="Clearaudio Champion Turntable" sizes="(min-width: 800px) 33vw, 100vw" />
      </div>
      <div class="caption">
        <p class="padding-top-0 padding-bottom-0">Clearaudio Champion Turntable</p>
      </div>
    </li>
    <li class='column quarter-autospacing rel'>
      <div class="rel ov-h">
