---
import ResponsiveImg from '../../../../components/ResponsiveImg.astro';
import Arrow from '../../../../components/Arrow.astro';
---

<div class='intro text-align-center'>
  <div class="container">
    <ResponsiveImg class="image margin-center reveal-up" src="/assets/media/b2b.png" alt="Audio Research SP-9 stereo preamplifier" sizes="(min-width: 800px) 33vw, 100vw" />
  </div>
</div>
<div class='container half-autospacing narrow text-align-center margin-top-0'>
  <h2>Business to Business Services</h2>
  <p class="xxnarrow margin-center">In addition to serving individuals looking to sell their pre-owned audio and video equipment, we also collaborate with businesses in a variety of ways. <a href="/contact/">Contact us</a> to discuss how we can work together.</p>
  <div class='actions margin-top-4'>
    <a class='text-turq text-uppercase tertiary-font' href='/business-to-business/'>
      View our B2B Services&nbsp;<span class="arrow"><Arrow /></span>
    </a>
  </div>
</div>