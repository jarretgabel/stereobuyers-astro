---
import Arrow from '../../../../components/Arrow.astro';
---

<div class='container half-autospacing narrow text-align-center margin-top-0'>
  <h2>Featured in...</h2>
  <div class='actions margin-top-4'>
    <div class="logos-grid">
      <div class="logo-grid-item">
        <a href="/recent-press-articles-and-news/">
          <img src="/assets/media/home-logo-1.svg" alt="The New York Times">
        </a>
      </div>
      <div class="logo-grid-item">
        <a href="/recent-press-articles-and-news/">
          <img src="/assets/media/home-logo-2.svg" alt="The Wall Street Journal">
        </a>
      </div>
      <div class="logo-grid-item">
        <a href="/recent-press-articles-and-news/">
          <img src="/assets/media/home-logo-3.svg" alt="Stereophile">
        </a>
      </div>
      <div class="logo-grid-item">
        <a href="/recent-press-articles-and-news/">
          <img src="/assets/media/home-logo-4.svg" alt="CNET">
        </a>
      </div>
      <div class="logo-grid-item">
        <a href="/recent-press-articles-and-news/">
          <img src="/assets/media/home-logo-6.svg" alt="The Absolute Sound">
        </a>
      </div>
    </div>
  </div>
</div>

<div class='actions text-align-center margin-top-4'>
  <a class='text-turq text-uppercase tertiary-font' href='/recent-press-articles-and-news/'>
    See what the press is saying&nbsp;<span class="arrow"><Arrow /></span>
  </a>
</div>