---
import Arrow from '../../components/Arrow.astro';
import Md from '../../components/Md.astro';
import QuickFacts from '../../components/QuickFacts.astro';
const { page } = Astro.props;
---
<section class='container xxnarrow sb-prose'>
  <Md text={page.intro} />

  <ul class="margin-top-4">
    {page.companies.map((c: any) => (
    <li>
      <h2 class="as-h4">{c.name}</h2>
      <p>{c.text}</p>
      <p>
        <a class='text-turq text-uppercase tertiary-font' href={c.url} target="_blank">
          Visit Site&nbsp;<span class="arrow"><Arrow /></span>
        </a>
      </p>
    </li>
    ))}
  </ul>
</section>

<section class='container xxnarrow margin-top-4'>
  <p>Related: <a href="/get-a-quote/">get a free quote</a>, <a href="/how-to-sell-your-high-end-audio-equipment-and-components-with-StereoBuyers/">how selling to us works</a>, <a href="/stereo-equipment-and-components-we-buy/">brands we buy</a>, or <a href="/contact/">contact us</a>.</p>
</section>

<QuickFacts />
