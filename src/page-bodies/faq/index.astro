---
import { data } from '../../lib/site';
---
<section class="container xnarrow margin-center">
  <p class="b2b-intro">Quick answers about selling your high-end audio equipment: what it is worth, how pickup works and when you get paid.</p>
  <p class="b2b-cta"><a class="button" href="/get-a-quote/">Get a free quote</a> <span>or call <a href="tel:+17182608948">(718) 260-8948</a></span></p>
  <p class="faq-jump">
    {data.faq.map((group: any) => <a href={`#${group.id}`}>{group.title}</a>)}
  </p>
</section>

<section class="container xnarrow margin-center faq-groups">
  {data.faq.map((group: any) => (
  <div class="faq-group" id={group.id}>
    <h2 class="as-h3">{group.title}</h2>
    {group.items.map((item: any) => (
    <details class="faq-item" open>
      <summary><h3>{item.q}</h3></summary>
      <p>{item.a}</p>
    </details>
    ))}
  </div>
  ))}
</section>

<section class="container xnarrow margin-center faq-cta">
  <h2 class="as-h4">Did not find your answer?</h2>
  <p>Ask us directly or get an offer on your equipment.</p>
  <p><a class="button" href="/get-a-quote/">Get a free quote</a> <a class="button button-outline" href="/contact/">Contact us</a></p>
</section>

<section class='container xxnarrow margin-top-4'>
  <p>Related: <a href="/how-to-sell-your-high-end-audio-equipment-and-components-with-StereoBuyers/">how selling to us works</a>, <a href="/stereo-equipment-and-components-we-buy/">brands we buy</a>, <a href="/service-area/">service area</a>, or <a href="/recent-press-articles-and-news/">press</a>.</p>
</section>
