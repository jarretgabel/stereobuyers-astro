---
import QuickFacts from '../../components/QuickFacts.astro';
const { page } = Astro.props;
const faq: { q: string; a: string }[] = page.faq ?? [];
const jsonLd = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
${faq.map((f) => `    { "@type": "Question", "name": ${JSON.stringify(f.q)}, "acceptedAnswer": { "@type": "Answer", "text": ${JSON.stringify(f.a)} } }`).join(',\n')}
  ]
}`;
---
<section class='container narrow margin-center'>
  <p class="b2b-intro">{page.intro}</p>
  <ul class="contact-cards">
    {page.cards.map((c: any) => (
    <li>
      <h2 class="as-h4">{c.title}</h2>
      <p>{c.text}</p>
      <a class="button" href={c.url}>{c.button}</a>
    </li>
    ))}
  </ul>
  <p class="text-align-center contact-meta">{page.meta}</p>
</section>

<section class='container narrow margin-center margin-top-4'>
  <h2 class="sb-heading">{page.linksHeading}</h2>
  <ul class="contact-links">
    {page.links.map((l: any) => (
    <li><a href={l.url}><strong>{l.title}</strong><span>{l.text}</span></a></li>
    ))}
  </ul>
</section>

<section class='brand-faq container xxnarrow margin-center autospacing-next'>
  <h2 class="sb-heading">{page.faqHeading}</h2>
  <dl>
    {faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
  </dl>
</section>
<script type="application/ld+json" set:html={jsonLd} />
