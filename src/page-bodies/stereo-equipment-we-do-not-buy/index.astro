---
import Md from '../../components/Md.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import { data } from '../../lib/site';
const { page } = Astro.props;
---
<section class="container margin-top-4">
  <div class="container xxnarrow">
    <Md text={page.intro} />
  </div>
  <ul class='brand-chips brand-chips-muted'>
    {data.equipment.brands_dont_buy.map((brand: string) => (
    <li><span>{brand}</span></li>
    ))}
  </ul>
  <div class="container xxnarrow b2b-cta">
    <p>Not sure whether your gear qualifies? <a class="button" href="/get-a-quote/">Ask for a free quote</a></p>
    <p><a href="/stereo-equipment-and-components-we-buy/">See the brands we do buy</a></p>
  </div>
</section>
<QuickFacts />
