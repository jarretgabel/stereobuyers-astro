---
import { site, data, pages } from '../../lib/site';
import Md from '../../components/Md.astro';
import QuickFacts from '../../components/QuickFacts.astro';

const { page } = Astro.props;

// Brand pages added in the CMS are listed (and linked) automatically; links to deleted pages are dropped.
const pageUrls = new Set(pages.map((p) => p.url));
const autoBrands = pages.filter((p) => p.layout === 'auto-brand' && p.brand);
const brandPages: Record<string, string> = {};
for (const [name, url] of Object.entries<string>(data.brand_pages)) if (pageUrls.has(url)) brandPages[name] = url;
const linked = new Set(Object.values(brandPages));
const known = new Set<string>(data.equipment.brands.map((b: string) => b.toLowerCase()));
const listed: string[] = data.equipment.brands.filter((b: string) => !(data.brand_pages[b] && !brandPages[b]));
for (const p of autoBrands) {
  if (linked.has(p.url)) continue;
  const name = String(p.brand);
  const existing = data.equipment.brands.find((b: string) => b.toLowerCase() === name.toLowerCase());
  brandPages[existing ?? name] = p.url;
  if (!known.has(name.toLowerCase())) listed.push(name);
}
const topExtra = autoBrands.filter((p) => p.top_brand).map((p) => ({ name: String(p.brand), url: p.url }));

const ascii = (s: string) => s.replace(/[A-Z]/g, (c) => c.toLowerCase());
const brands: string[] = [...new Set<string>(listed)].sort((a, b) => {
  const x = ascii(a), y = ascii(b);
  return x < y ? -1 : x > y ? 1 : 0;
});
const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const first = (b: string) => [...b.trim()][0]?.toUpperCase();
const groups = letters.map((l) => ({ l, items: brands.filter((b) => first(b) === l) })).filter((g) => g.items.length > 0);
let pos = 0;
const listItems = brands.filter((b) => brandPages[b]).map((b) => ({
  '@type': 'ListItem', position: ++pos, name: b, url: `${site.url}${brandPages[b]}`,
}));
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Brands StereoBuyers buys',
  url: `${site.url}/stereo-equipment-and-components-we-buy/`,
  mainEntity: { '@type': 'ItemList', itemListElement: listItems },
});
---
<section class='container xxnarrow'>
  <Md text={page.intro} />
  <ul class="top-brands">
    {[...page.topBrands, ...topExtra].map((b: any) => <li><a href={b.url}>{b.name}</a></li>)}
  </ul>
</section>
<section class="container margin-top-4">
  <div class="container xxnarrow">
    <Md text={page.brandsIntro} />
  </div>
  <div class="container xnarrow brand-az">
    <input type="search" id="brand-filter" placeholder="Search brands" aria-label="Search brands">
    <p class="az-jump">{groups.map((g) => <a href={`#brands-${g.l}`}>{g.l}</a>)}</p>
    {groups.map((g) => (
      <div class="az-group" id={`brands-${g.l}`}>
        <h3>{g.l}</h3>
        <ul>{g.items.map((b) => <li>{brandPages[b] ? <a href={brandPages[b]}>{b}</a> : b}</li>)}</ul>
      </div>
    ))}
  </div>
  <script is:inline>
    document.getElementById('brand-filter').addEventListener('input', function (e) {
      var q = e.target.value.toLowerCase();
      document.querySelectorAll('.az-group').forEach(function (g) {
        var any = false;
        g.querySelectorAll('li').forEach(function (li) { var m = li.textContent.toLowerCase().indexOf(q) !== -1; li.hidden = !m; any = any || m; });
        g.hidden = !any;
      });
    });
  </script>
</section>
<script type="application/ld+json" set:html={jsonLd} />
<QuickFacts />
