---
import QuickFacts from '../../components/QuickFacts.astro';
import { renderInline } from '../../lib/markdown';
const { page } = Astro.props;
const faq: { q: string; a: string }[] = page.faq ?? [];
const jsonLd = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
${faq.map((f) => `    { "@type": "Question", "name": ${JSON.stringify(f.q)}, "acceptedAnswer": { "@type": "Answer", "text": ${JSON.stringify(f.a)} } }`).join(',\n')}
  ]
}`;
---
<section class='container xxnarrow margin-center'>
  <p class="b2b-intro" set:html={renderInline(page.intro)} />
  <p class="b2b-cta"><a class="button" href="/get-a-quote/">Get a free quote</a> <span>or call <a href="tel:+17182608948">718-260-8948</a></span></p>
</section>

{page.groups.map((g: any) => (
<section class='container narrow margin-center b2b-section'>
  <h2 class="sb-heading">{g.heading}</h2>
  {g.intro && <p class="text-align-center">{g.intro}</p>}
  <ul class="b2b-cards">
    {g.cards.map((c: any) => (
    <li>
      <h3>{c.title}</h3>
      <p>{c.text}</p>
    </li>
    ))}
  </ul>
</section>
))}

<section class='brand-faq container xxnarrow margin-center autospacing-next'>
  <h2 class="sb-heading">{page.faqHeading}</h2>
  <dl>
    {faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
  </dl>
</section>
<script type="application/ld+json" set:html={jsonLd} />

<section class='container xxnarrow margin-top-4'>
  <p>Related: <a href="/get-a-quote/">get a free quote</a>, <a href="/how-to-sell-your-high-end-audio-equipment-and-components-with-StereoBuyers/">how selling to us works</a>, <a href="/stereo-equipment-and-components-we-buy/">brands we buy</a>, or <a href="/contact/">contact us</a>.</p>
</section>

<QuickFacts />
