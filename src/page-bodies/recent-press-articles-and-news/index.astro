---
import Arrow from '../../components/Arrow.astro';
import PressStrip from '../../components/PressStrip.astro';
import { data } from '../../lib/site';

const articles = data.press.articles as any[];
---
<section class="container xxnarrow press-intro">
  <p>We love a good stereo article – especially when it’s about us! Below is a sampling of our favorite StereoBuyers press stories and blog mentions. For any media inquiries, please <a href="/contact/">contact us</a>.</p>
</section>

<PressStrip />

<section class="container xnarrow press-list">
  <h2 class="text-align-center as-h3">Where has StereoBuyers been?</h2>
  <ul>
    {articles.map((article) => (
      <li class="press-entry">
        <div class="press-meta">
          <span class="press-source" set:html={article.source}></span>
          <span class="press-date" set:html={article.date}></span>
        </div>
        <div class="press-body">
          <h3><a href={article.url} target={article.view || article.readmore ? '_blank' : undefined} rel={article.view || article.readmore ? 'noopener' : undefined} set:html={article.title}></a></h3>
          {article.body && <p set:html={article.body}></p>}
          {(article.readmore === true || article.view) && (
            <a class="press-link" href={article.url} target="_blank" rel="noopener">
              {article.view ? 'Watch' : 'Read article'}<span class="arrow"><Arrow /></span>
            </a>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>
